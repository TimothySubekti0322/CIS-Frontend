# ---------------------------------------------------------------------------
# CIS Frontend — environment variables
# Copy this file to `.env` and adjust. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Display name of the app (shown in sidebar / auth screens / <title>)
NEXT_PUBLIC_APP_NAME="Climate Action & Narrative Validation System"

# Origin of the CIS backend. Used only when NEXT_PUBLIC_API_MODE=live.
# No trailing slash; the version prefix below is appended per request.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"

# Version prefix every route sits behind. The two health probes
# (/health, /health/ready) are mounted at the root and skip this.
NEXT_PUBLIC_API_PREFIX="/api/v1"

# Data source mode:
#   mock  -> served by the in-memory mock layer, which returns the same
#            envelopes and snake_case payloads the backend does (default)
#   live  -> requests hit NEXT_PUBLIC_API_BASE_URL + NEXT_PUBLIC_API_PREFIX
NEXT_PUBLIC_API_MODE="mock"

# ---------------------------------------------------------------------------
# Not used by the frontend — listed so the backend contract lives in one place.
#
# INTERNAL_API_KEY  the X-Internal-Key the AI service sends to
#                   POST /api/v1/internal/policies/:id/matchmaking-result.
#                   Machine-to-machine only; never expose it to the browser
#                   and never prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
