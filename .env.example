# ---------------------------------------------------------------------------
# CIS Frontend — environment variables
# Copy this file to `.env` and adjust. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Display name of the app (shown in sidebar / auth screens / <title>)
NEXT_PUBLIC_APP_NAME="Climate Immune System"

# Base URL of the CIS backend API. Used only when NEXT_PUBLIC_API_MODE=live.
NEXT_PUBLIC_API_BASE_URL="https://api.cis.example.com"

# Data source mode:
#   mock  -> all requests are served by the local in-memory mock layer (default, no backend needed)
#   live  -> requests hit NEXT_PUBLIC_API_BASE_URL (endpoint paths in src/lib/api/endpoints.ts)
NEXT_PUBLIC_API_MODE="mock"

# ---------------------------------------------------------------------------
# Server-only secrets (never exposed to the browser). Add real values here
# once the backend is ready. Do NOT prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# API_SERVICE_TOKEN=""
